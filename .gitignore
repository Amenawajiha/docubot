# Ignore all root-level directories and files
/*

# Allow backend, frontend, chatbot-rag, deployment files, and this gitignore file
!/docubot-backend/
!/docubot-frontend/
!/chatbot-rag/
!/docker-compose*.yml
!/nginx/
!/.env.example
!.gitignore

# Frontend ignores
docubot-frontend/node_modules/
docubot-frontend/.next/
docubot-frontend/out/
docubot-frontend/build/
docubot-frontend/.env*
docubot-frontend/.vercel/
docubot-frontend/*.tsbuildinfo
docubot-frontend/next-env.d.ts
docubot-frontend/coverage/

# Python / Backend ignores
docubot-backend/.venv/
docubot-backend/.env
docubot-backend/.pytest_cache/
docubot-backend/server.log
chatbot-rag/.venv/
chatbot-rag/.env*
chatbot-rag/.pytest_cache/
chatbot-rag/conversations/
chatbot-rag/uploads/
chatbot-rag/logs/
chatbot-rag/*.log
chatbot-rag/.coverage
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.db
**/*.sqlite

# OS / IDE specific ignores
.DS_Store
.idea/
.vscode/
