# Ignore all root-level directories and files
/*

# Allow backend, frontend, deployment files, and this gitignore file
!/docubot-backend/
!/docubot-frontend/
!/docker-compose*.yml
!/nginx/
!/.env.example
!.gitignore

# Frontend ignores
docubot-frontend/node_modules/
docubot-frontend/.next/
docubot-frontend/out/
docubot-frontend/build/
docubot-frontend/.env*
docubot-frontend/.vercel/
docubot-frontend/*.tsbuildinfo
docubot-frontend/next-env.d.ts
docubot-frontend/coverage/

# Python / Backend ignores
docubot-backend/.venv/
docubot-backend/.env
docubot-backend/.pytest_cache/
docubot-backend/server.log
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.db
**/*.sqlite

# OS / IDE specific ignores
.DS_Store
.idea/
.vscode/
